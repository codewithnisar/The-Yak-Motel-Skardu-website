# ===========================
# The Grind Cafe — .gitignore
# ===========================

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE / Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*

# Node (if ever added)
node_modules/
package-lock.json

# Environment
.env
.env.local
.env.production

# Build artifacts
dist/
build/
.cache/

# Temporary files
*.tmp
*.bak
*.orig
